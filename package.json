{
  "name": "dsh-mindmap",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Native-first Markdown mindmap viewer for DeepSeek Harness, with optional Better Sidebar integration",
  "license": "MIT",
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./src/assets/locale/*.json",
    "./icon": "./src/assets/icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "src/assets/icon.svg",
    "src/assets/locale/*.json"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/check-client-bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@markmap/element": "1.1.1",
    "@markmap/render": "1.1.0",
    "@markmap/canvas": "1.1.1",
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "dsh-better-sidebar": "^0.32.1",
    "react": "^18.2.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@types/react": "~18.3.1",
    "@types/node": "^24.0.0",
    "dsh-better-sidebar": "0.32.1",
    "react": "18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "icon": "./src/assets/icon.svg",
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
